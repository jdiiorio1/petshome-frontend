<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CuidadorPresentacionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            >
            <io.github.florent37.shapeofview.shapes.DiagonalView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:elevation="4dp"
                app:shape_diagonal_angle="10"
                app:shape_diagonal_position="bottom"
                android:backgroundTint="@color/verde_claro"
                >
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/verde_claro" />


            </io.github.florent37.shapeofview.shapes.DiagonalView>
            <io.github.florent37.shapeofview.shapes.CircleView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:translationY="10dp"
                android:elevation="4dp"
                app:shape_circle_borderColor="@android:color/holo_green_light"
                app:shape_circle_borderWidth="4dp">

                <!-- YOUR CONTENT -->
                <ImageView
                    android:id="@+id/img_profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_account_circle"
                    android:layout_gravity="center" />

            </io.github.florent37.shapeofview.shapes.CircleView>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_nombre_cuidador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOMBRE CUIDADOR"
            android:textAlignment="center"
            android:textSize="22sp"
            android:layout_marginTop="20dp"/>

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVICIOS"
            android:textAlignment="textStart"
            android:textSize="12sp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/reciclador_servicios"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="5dp"
            android:scrollbars="vertical"
            android:layoutAnimation="@anim/layout_animation"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COMENTARIOS"
            android:textAlignment="textStart"
            android:textSize="12sp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/reciclador_comentarios"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="5dp"
            android:scrollbars="vertical"
            android:layoutAnimation="@anim/layout_animation"/>



    </LinearLayout>
    <Button
        android:id="@+id/btn_contactar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:text="CONTACTAR"
        android:backgroundTint="@color/verde_claro"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>