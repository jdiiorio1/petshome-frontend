<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PropiedadActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.github.florent37.shapeofview.shapes.DiagonalView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:elevation="4dp"
            app:shape_diagonal_angle="10"
            app:shape_diagonal_position="bottom"
            android:backgroundTint="@color/verde_claro"
            >
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/verde_claro" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MI PROPIEDAD"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:layout_marginTop="20dp"/>


            <ImageView
                android:id="@+id/img_profile_photo"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/ic_casa"
                app:tint="@color/white"
                android:scaleType="fitCenter"
                android:layout_gravity="center" />





        </io.github.florent37.shapeofview.shapes.DiagonalView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_calle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Calle"
                android:textSize="14sp"
                android:inputType="text" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_numero"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="Numero"
                android:layout_gravity="right"
                android:textSize="14sp"
                android:inputType="number" />

        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center">



            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_localidad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Localidad"
                android:textSize="14sp"
                android:inputType="text"
                />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_cp"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="Codigo Postal"
                android:layout_gravity="right"
                android:textSize="14sp"
                android:inputType="text"
                />

        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            >



            <Spinner
                android:id="@+id/sp_tipo_vivienda"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/gris_claro"
                />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_piso"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:hint="Piso"
                android:textSize="14sp"
                android:inputType="text"
                android:visibility="invisible"
                />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_departamento"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:hint="Departamento"
                android:textSize="14sp"
                android:inputType="text"
                android:visibility="invisible"
                />


        </LinearLayout>

        <Button
            android:id="@+id/btn_validar_ubicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:text="VALIDAR UBICACION"
            android:backgroundTint="@color/verde_claro"/>

        <org.osmdroid.views.MapView
            android:id="@+id/map_validar"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center"
            android:visibility="gone"/>


    </LinearLayout>

    <Button
        android:id="@+id/btn_registrar_propiedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:text="REGISTRAR PROPIEDAD"
        android:backgroundTint="@color/verde_claro"/>

    <io.github.florent37.shapeofview.shapes.CircleView

        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="5dp"
        android:elevation="4dp"
        app:shape_circle_borderColor="@color/white"
        app:shape_circle_borderWidth="2dp">

        <!-- YOUR CONTENT -->

        <ImageView
            android:id="@+id/img_atras"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_atras"
            app:tint="@color/white"
            android:paddingLeft="10dp"
            android:scaleType="centerInside"
            android:background="@color/verde_claro"
            android:backgroundTint="@color/verde_claro"
            android:layout_gravity="left|top" />


    </io.github.florent37.shapeofview.shapes.CircleView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>